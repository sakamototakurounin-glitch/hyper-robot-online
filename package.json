{
  "name": "hyper-robot-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "node --check dist/server/index.js && node --check dist/server/ui.js",
    "db:create": "wrangler d1 create hyper-robot-db",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run db:migrate && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}